# Copy this file to .env and fill in real values. .env is gitignored.
POSTGRES_DB=ledgerguard
POSTGRES_USER=ledgerguard
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# Task 12: local Kafka broker (docker-compose.yml). No credentials --
# PLAINTEXT is for local development only.
KAFKA_PORT=9092

# Task 17: JWT signing key -- a Base64-encoded value that decodes to at
# least 32 bytes (256 bits). Generate a real one for any non-local
# deployment, e.g.: openssl rand -base64 32
# Never commit a real production signing key. The value below is a
# generated example only, safe to keep in source control the same way
# POSTGRES_PASSWORD=changeme above is -- it grants no access to anything,
# since it only signs tokens for the two demo identities below.
JWT_SIGNING_KEY=y7Ge6DDPY9M6C2R/wM58bVB0U4S3AJTDEyfFKTpXpM0=

# Task 17: BCrypt hashes (never plaintext) for the fixed demo identities.
# The defaults baked into application.yml correspond to the passwords
# "demo-customer-password" and "demo-operations-password" -- for local
# demo use only. Override both for any non-local deployment.
DEMO_CUSTOMER_PASSWORD_HASH=$2b$10$KxMCQkZFWnvzSR8LtDbmQuKBL6bm0.AcvICXc6v4hbAiKAItdLPDS
DEMO_OPERATIONS_PASSWORD_HASH=$2b$10$r69EIVfioUczWi/S0Dk5Je7QImoc5vQxLhOJWMtzVVYEza3bxduau
